# Copy this file to `.env` and fill in your own keys.
# `.env` is git-ignored — it will never be committed.
#
# Every module works without its key: it simply prints a notice and skips
# that specific check. You do NOT need every key to use this tool.

# https://www.abuseipdb.com/account/api  (free tier available)
ABUSEIPDB_API_KEY=

# https://www.virustotal.com/gui/join-us  (free tier available)
VIRUSTOTAL_API_KEY=

# https://account.shodan.io/register  (free tier available, limited)
SHODAN_API_KEY=

# https://ipinfo.io/signup  (optional — works without a key at low volume)
IPINFO_API_KEY=

# Optional tuning
RECON_TIMEOUT=15
RECON_USER_AGENT=osint-recon-cli/1.0
